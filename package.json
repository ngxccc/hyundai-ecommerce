{
  "name": "hyundai-ecommerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "doppler run -- turbo run build",
    "check-types": "turbo run check-types",
    "clean": "bunx rimraf '**/node_modules' '**/.next' '**/.turbo'",
    "clean:hard": "bunx rimraf '**/node_modules' '**/.next' '**/.turbo' 'bun.lock' && bun install",
    "deps:fix": "syncpack fix",
    "deps:lint": "syncpack list",
    "dev": "doppler run -- turbo run dev",
    "dev:storefront": "doppler run -- turbo run dev --filter=storefront",
    "format:pkg": "syncpack format",
    "format:pkg:check": "syncpack format --check",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "verify": "turbo run lint check-types test --force",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "^1",
    "@types/node": "^26",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "syncpack": "^15.3.3",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "browserslist": "^4.28.8",
    "minimatch@<10": {
      "brace-expansion": "^1.1.18"
    },
    "minimatch@>=10": {
      "brace-expansion": "^5.0.9"
    }
  }
}
