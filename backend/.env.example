# Application Config
NODE_ENV="development"
APP_ENV="development"
LOG_LEVEL="debug"
PORT=4000
DOMAIN_NAME="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3001"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Database Config (PostgreSQL / Neon)
DB_URL="postgres://postgres:postgrespassword@localhost:5432/hyundai_ecommerce?sslmode=disable"
DB_HOST="localhost"
DB_PORT=5432
DB_USERNAME="postgres"
DB_PASSWORD="postgrespassword"
DB_DATABASE="hyundai_ecommerce"
DB_LOGGING=true

# Redis Config (Upstash / Local Redis for BullMQ & Distributed Locks)
REDIS_URL="rediss://default:your_redis_password@your-redis-instance.upstash.io:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379

# JWT Authentication Config
JWT_SECRET="super-secret-jwt-key-minimum-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# PayOS Payment Gateway
PAYOS_CLIENT_ID="your_payos_client_id"
PAYOS_API_KEY="your_payos_api_key"
PAYOS_CHECKSUM_KEY="your_payos_checksum_key"

# Resend Transactional Email
RESEND_API_KEY="re_123456789_abcdef"
EMAIL_FROM="Hyundai Nhat Nang <onboarding@resend.dev>"

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# E-commerce Business Parameters
VAT_RATE=0.1
DEPOSIT_RATE=0.2

# Cron & Background Automation
CRON_SECRET="your_cron_bearer_token"

# Telegram Notifications (Ops & Alerts)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_ADMIN_CHAT_ID="-1001234567890"

# Sentry Observability (Optional in local development)
SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE=1.0
