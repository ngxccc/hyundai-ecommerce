{
  "name": "backend",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "description": "Hyundai E-commerce Backend API",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "check": "bun run check-types && bun run lint",
    "dev": "doppler run -- nest start --watch --exec bun",
    "dev:test": "doppler run -c test_backend -- nest start --watch --exec bun",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"eslint.config.ts\" \"drizzle.config.ts\"",
    "lint": "eslint . --fix --cache --cache-location .eslintcache",
    "start": "doppler run -- bun dist/main.js",
    "start:test": "doppler run -c test_backend -- bun dist/main.js",
    "start:debug": "doppler run -- nest start --debug --watch --exec bun",
    "test": "bun test src/ --bail",
    "test:cov": "bun test src/ --coverage",
    "test:ci": "mkdir -p coverage && bun test src/ --coverage --reporter=junit --reporter-outfile=coverage/junit.xml",
    "test:e2e": "doppler run --preserve-env=\"true\" -c test_backend -- bun test test/",
    "test:bench": "doppler run --preserve-env=\"true\" -c test_backend -- bun test/benchmarks/runner.ts",
    "test:watch": "bun test src/ --watch",
    "test:load:build": "bun build test/load/booking-concurrency.k6.ts --target=browser --external \"k6\" --external \"k6/*\" --outfile dist/booking-concurrency.k6.js",
    "test:load:seed": "doppler run --preserve-env=\"true\" -c test_backend -- bun test/load/seed.ts",
    "test:load:run": "k6 run dist/booking-concurrency.k6.js",
    "test:load:verify": "doppler run --preserve-env=\"true\" -c test_backend -- bun test/load/verify-and-teardown.ts",
    "test:load": "bun run test:load:build && bun run test:load:seed && bun run test:load:run && bun run test:load:verify",
    "db:baseline": "doppler run -c dev_backend -- bun scripts/baseline.ts && doppler run -c prd_backend -- bun scripts/baseline.ts --inject-only && doppler run -c test_backend -- bun scripts/baseline.ts --inject-only",
    "db:generate": "doppler run -c dev_backend -- drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "sh -c 'if [ $# -eq 0 ]; then doppler run --preserve-env=\"true\" -- drizzle-kit migrate --config drizzle.config.ts; echo \"\"; else for e in \"$@\"; do echo \"\"; echo \"[DB Migrate] Running for config: $e\"; doppler run --preserve-env=\"true\" -c \"$e\" -- drizzle-kit migrate --config drizzle.config.ts || exit 1; echo \"\"; done; fi' _",
    "db:push": "sh -c 'if [ $# -eq 0 ]; then doppler run --preserve-env=\"true\" -- drizzle-kit push --config drizzle.config.ts; echo \"\"; else for e in \"$@\"; do echo \"\"; echo \"[DB Push] Running for config: $e\"; doppler run --preserve-env=\"true\" -c \"$e\" -- drizzle-kit push --config drizzle.config.ts || exit 1; echo \"\"; done; fi' _",
    "db:reset-schema": "sh -c 'if [ $# -eq 0 ]; then doppler run --preserve-env=\"true\" -- bun scripts/reset-db.ts; else for e in \"$@\"; do echo \"\"; echo \"[DB Reset Schema] Running for config: $e\"; doppler run --preserve-env=\"true\" -c \"$e\" -- bun scripts/reset-db.ts || exit 1; echo \"\"; done; fi' _",
    "db:seed": "doppler run --preserve-env=\"true\" -c dev_backend -- bun src/database/seeds/index.ts",
    "db:seed:reset": "doppler run --preserve-env=\"true\" -c dev_backend -- bun src/database/seeds/index.ts --reset",
    "db:seed:clean": "doppler run --preserve-env=\"true\" -c dev_backend -- bun src/database/seeds/index.ts --clean",
    "db:studio": "doppler run -c dev_backend -- drizzle-kit studio --config drizzle.config.ts",
    "i18n:generate": "nestjs-i18n -p ./src/i18n/ -o ./src/generated/i18n.generated.ts",
    "openapi:generate": "doppler run -c test_backend -- bun scripts/generate-openapi-types.ts",
    "check-types": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/schedule": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@payos/node": "^2.0.5",
    "@scalar/nestjs-api-reference": "^1.2.17",
    "@sentry/nestjs": "^10.73.0",
    "@t3-oss/env-core": "^0.13.11",
    "bullmq": "^6.3.4",
    "drizzle-orm": "^1.0.0-rc.5-169397b",
    "fast-deep-equal": "^3.1.3",
    "ioredis": "^6.0.0",
    "nestjs-i18n": "^10.8.5",
    "nestjs-pino": "^5.1.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "redlock": "^5.0.0-beta.2",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.25.0",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.7",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bun": "^1",
    "@types/express": "^5.0.6",
    "@types/k6": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "drizzle-kit": "^1.0.0-rc.5-ab785fc",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.4.1",
    "openapi-typescript": "^7.13.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^6",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "multer": "^2.2.0",
    "lodash": "^4.18.1",
    "qs": "^6.15.3",
    "js-yaml": "^4.3.1",
    "postcss": "^8.5.26",
    "nanoid": "^3.3.18"
  }
}
